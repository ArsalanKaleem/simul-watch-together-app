# ─────────────────────────────────────────────────────────────
# You normally DON'T need this file.
#
# LiveKit is configured INSIDE the app now: open the ⚙️ Settings screen and
# paste your LiveKit URL + API key/secret. They're saved to secure storage and
# the app mints tokens on-device — no build flags, no server.
#
# Firebase is already configured in lib/firebase_options.dart (maintainer's).
#
# The values below are only an OPTIONAL fallback: if Settings is left empty,
# the app reads these dart-define values (see lib/utils/constants.dart).
# ─────────────────────────────────────────────────────────────
USE_PRODUCTION=true
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_TOKEN_URL=https://YOUR_TOKEN_SERVER/token
