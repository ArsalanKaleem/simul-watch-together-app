# Values you pass to the Flutter app at build/run time via --dart-define.
# Copy the run commands from README, or use scripts/run_web.sh.
#
# Firebase is already configured in lib/firebase_options.dart (maintainer's
# project) — you do NOT need to set anything for Firebase.
#
# You ONLY need to point the app at YOUR LiveKit + token server:

USE_PRODUCTION=true
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_TOKEN_URL=https://YOUR_TOKEN_SERVER/token
