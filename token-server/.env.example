# ─── LiveKit API credentials ──────────────────────────────────
# Get these from your LiveKit Cloud project:
#   https://cloud.livekit.io  →  Settings → Keys → Create Key
# (For local dev with `livekit-server --dev`, the defaults below work.)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Port the token server listens on (the app calls /token here)
PORT=5000
