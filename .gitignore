# ─── Secrets — DO NOT COMMIT ──────────────────────────────────
# Real LiveKit API key/secret live only in the token server env:
token-server/.env
.env
*.env.local
# Firebase service-account credentials (server-side keys) — never commit:
**/serviceAccount*.json
**/google-services.json
**/GoogleService-Info.plist

# NOTE: lib/firebase_options.dart is intentionally committed — this project
# uses a single shared Firebase backend (the maintainer's). Client Firebase
# keys are safe to expose ONLY while Firestore rules + App Check are locked
# down. Do not commit any server-side service-account JSON, though.

# ─── Node (token server) ──────────────────────────────────────
node_modules/
npm-debug.log*
